# 2026-11-10 期間内に書き直し。
# このファイルを .env にコピーして値を入れる。.env はコミットしない。

# ── ブラウザーに届く値（VITE_ で始まるものは公開される前提） ──

# APK や静的ホスティングから別の HTTPS API を使うときだけ。秘密の鍵はサーバー側に残る
# VITE_API_BASE_URL=https://your-api.example.com

# Google Maps のキー。公開されるので、HTTP リファラーと使える API を必ず絞る
VITE_GOOGLE_MAPS_API_KEY=

# Firebase の設定（JSON）。匿名認証と Firestore を有効にし、firestore.rules を反映してから入れる
VITE_FIREBASE_CONFIG=

# ── サーバーだけで使う値（VITE_ を付けない） ──

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_WEATHER_API_KEY=

# Google ログインと Google Health（任意。休憩シートで使う）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 書かなければ http://<Host>/api/auth/google/callback を使う
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5188/api/auth/google/callback

PORT=8787

# ── 公開するときだけ ──

# 受け付けるホスト。Vercel では省略すると本番ドメインとデプロイ自身の URL を使う
# PUBLIC_ORIGIN=https://epoku.vercel.app

# Vercel で Google ログインを使うなら必須。ログイン情報を暗号化して Cookie に入れる鍵（32 文字以上のランダム値）
# SESSION_SECRET=

# Gemini を Vertex AI 経由で呼ぶとき（GEMINI_API_KEY があればそちらを優先）
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_HOURLY_LIMIT=300

# Vercel から鍵なしで Vertex AI を呼ぶとき（OIDC Federation → Workload Identity 連携）
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=epoku-vertex@PROJECT_ID.iam.gserviceaccount.com
