# Optional public HTTPS API for APK/static hosting; server secrets stay on server
# VITE_API_BASE_URL=https://your-api.example.com
# Mapsのキーは公開情報です。HTTPリファラー・APIの利用制限を設定してください。
VITE_GOOGLE_MAPS_API_KEY=
# Firebaseは匿名認証・Firestoreと同梱ルールを有効にしてから設定。
VITE_FIREBASE_CONFIG=
# 以下はサーバー専用。VITE_を付けないでください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_WEATHER_API_KEY=
PORT=8787
