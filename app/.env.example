# すべて空でも動きます（APIなしのデモ）。キーを入れると、その機能だけ実データに切り替わります。2026-11-10 作成
# ── 画面に埋め込まれる公開設定（VITE_ で始まる）──
# Google マップ（2D）。HTTPリファラーと API の制限を必ずかける
VITE_GOOGLE_MAPS_API_KEY=
# 投稿の共有（Firebase の Web アプリ設定を1行のJSONで）
VITE_FIREBASE_CONFIG=
# APK や別ホストから API を呼ぶときの接続先（HTTPS のみ）
# VITE_API_BASE_URL=https://your-api.example.com
# ── サーバーだけが使う秘密の設定（VITE_ を付けない）──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_WEATHER_API_KEY=
# Googleログイン・Google Health（休憩シート）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5188/api/auth/google/callback
PORT=8787
# 公開時（Cloud Run・Vercel）だけ: サービスの URL。そのホストだけを受け付け、画面も同じサーバーから配る
# PUBLIC_ORIGIN=https://epoku-xxxxxxxx.asia-northeast1.run.app
# Gemini を Vertex AI で呼ぶとき（Cloud Run 上。GEMINI_API_KEY があればそちらが優先）
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_HOURLY_LIMIT=300
# Vercel では VERCEL_URL・VERCEL_BRANCH_URL（自動で入る）のホストも受け付ける
# Vercel から Vertex AI を使うとき（Workload Identity 連携）は app/docs/API_GUIDE.md の Vercel の節を参照
