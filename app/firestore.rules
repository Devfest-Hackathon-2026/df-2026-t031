rules_version = '2';
// 投稿の共有（src/lib/shared.ts）。匿名ログインした人だけが読み書きでき、自分の投稿だけ消せる。2026-11-10 作成
service cloud.firestore {
  match /databases/{database}/documents {
    match /epokuReports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'spotId', 'value', 'ownerUid', 'createdAt'])
        && request.resource.data.id == id
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.spotId is string && request.resource.data.spotId.size() <= 150
        && request.resource.data.value in ['sat', 'full', 'missing', 'facility']
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
