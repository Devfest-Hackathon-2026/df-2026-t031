rules_version = '2';

// 2026-11-10 期間内に書き直し。
// 共有の「座れた・満席・見当たらない」投稿だけを置く。ログイン（匿名認証可）が前提。
service cloud.firestore {
  match /databases/{database}/documents {

    match /epokuReports/{reportId} {
      function signedIn() {
        return request.auth != null;
      }

      // 新しく書く投稿の形。決めた項目だけ・本人の uid・サーバー時刻
      function validNewReport() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'spotId', 'value', 'ownerUid', 'createdAt'])
          && d.ownerUid == request.auth.uid
          && d.id is string && d.id.size() <= 150
          && d.spotId is string && d.spotId.size() <= 150
          && d.value in ['sat', 'full', 'missing']
          && d.createdAt == request.time
          // 文書 ID は「uid_投稿ID」。他人の ID を名乗れない
          && reportId == request.auth.uid + '_' + d.id;
      }

      allow get: if signedIn();
      // 一覧は件数を指定したときだけ（最大 250 件）
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 250;
      allow create: if signedIn() && validNewReport();
      // 投稿は書き換えさせない。取り消しは本人の削除だけ
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
