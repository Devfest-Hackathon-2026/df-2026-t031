{
 "name": "rest-care",
 "private": true,
 "version": "0.4.0",
 "type": "module",
 "description": "Rest Care — 体調や状況に合った休憩を取りやすくする休憩スポットマップ。OSM の同梱データで動き、Google の API は任意で接続。",
 "engines": {"node": ">=22.18.0"},
 "scripts": {
  "dev": "vite",
  "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
  "dev:all": "node scripts/dev-all.mjs",
  "server": "node server/index.ts",
  "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
  "preview": "vite preview",
  "typecheck": "tsc -b",
  "test": "vitest run",
  "test:watch": "vitest",
  "data:osm": "node scripts/fetch-osm.ts",
  "cap:sync": "npm run build && cap sync android",
  "apk": "node scripts/build-apk.mjs"
 },
 "dependencies": {
  "@capacitor/android": "^8.6.0",
  "@capacitor/core": "^8.6.0",
  "firebase": "^13.2.0",
  "lucide-react": "^1.68.0",
  "react": "^19.3.1",
  "react-dom": "^19.3.1",
  "suncalc": "^2.1.1",
  "three": "^0.187.0"
 },
 "overrides": {"@grpc/grpc-js": "^1.14.7"},
 "devDependencies": {
  "@capacitor/cli": "^8.6.0",
  "@types/google.maps": "^3.66.9",
  "@types/node": "^24.0.0",
  "@types/react": "^19.3.0",
  "@types/react-dom": "^19.3.0",
  "@types/three": "^0.187.0",
  "@vitejs/plugin-react": "^6.2.1",
  "draco3d": "^1.5.9",
  "jsdom": "^30.1.3",
  "typescript": "^7.0.2",
  "vite": "^8.3.5",
  "vitest": "^5.1.0"
 }
}
